# Copy to .env  (npm run dev creates .env and a SESSION_SECRET for you)
# NEVER commit .env

# Postgres connection string (rotate any password that was ever committed)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random 32+ chars. Generated automatically on first "npm run dev".
SESSION_SECRET=

# Optional
# SEED_PASSWORD=choose-a-password-for-the-seeded-demo-accounts
# API_PORT=4000
# COOKIE_SECURE=true            # set when served over HTTPS
# RATE_LIMIT_MAX=3000
# DB_SSL_REJECT_UNAUTHORIZED=false   # local dev with self-signed cert only
