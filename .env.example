# ===========================================
# Examination and Results Management System
# Environment Variables Template
# ===========================================
# 
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Example: postgresql://admin:mypassword@localhost:5432/ierms?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# SSL Certificate Verification
# Set to 'false' only for local development with self-signed certificates
# DB_SSL_REJECT_UNAUTHORIZED=false

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# Session Secret Key
# MUST be 32+ characters for security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Default Password for Seeded Accounts
# Used when running 'npm run db:seed'
# Leave empty to generate a random password
SEED_PASSWORD=

# Cookie Security
# Set to 'true' in production when using HTTPS
COOKIE_SECURE=false

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================

# Node Environment
# Options: development, production, test
NODE_ENV=development

# API Server Port (if running separate backend)
# Not needed for fullstack Next.js setup
# API_PORT=4000

# Rate Limiting
# Maximum requests per 15-minute window
RATE_LIMIT_MAX=3000

# ===========================================
# OPTIONAL SERVICES
# ===========================================

# Email Configuration (if using email features)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@example.com

# File Upload Configuration
# MAX_FILE_SIZE=5242880  # 5MB in bytes
# UPLOAD_DIR=./uploads

# ===========================================
# EXTERNAL SERVICES (if needed)
# ===========================================

# AWS S3 (for file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=

# Redis (for caching/sessions)
# REDIS_URL=redis://localhost:6379

# ===========================================
# NOTES
# ===========================================
# 
# 1. Required variables: DATABASE_URL, SESSION_SECRET
# 2. For first run, execute: npm run db:seed
# 3. Reset passwords with: npm run db:reset-password
# 4. See README.md for detailed setup instructions
#
